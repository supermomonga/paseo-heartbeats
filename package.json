{
  "name": "paseo-heartbeats",
  "version": "0.1.2",
  "description": "Shows a session's heartbeats in its composer, and lets you edit, pause, run, and review them in the side panel.",
  "keywords": [
    "paseo",
    "paseo-plugin",
    "heartbeat",
    "schedule",
    "cron"
  ],
  "homepage": "https://github.com/supermomonga/paseo-heartbeats#readme",
  "bugs": "https://github.com/supermomonga/paseo-heartbeats/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/supermomonga/paseo-heartbeats.git"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "OVERVIEW.*.md",
    "assets/",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "npm-shrinkwrap.json",
    "!**/*.test.ts"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json",
    "test": "vitest run --passWithNoTests",
    "prepack": "node scripts/pack-manifest.mjs prepack",
    "postpack": "node scripts/pack-manifest.mjs postpack"
  },
  "dependencies": {
    "@getpaseo/client": "0.15.4"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.15.4",
    "@getpaseo/protocol": "0.15.4",
    "@tanstack/react-query": "5.90.11",
    "@types/node": "22.18.3",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "5.9.2",
    "vitest": "3.2.7",
    "zod": "4.4.3"
  }
}
