{
  "name": "paseo-heartbeats",
  "version": "0.1.0",
  "description": "Paseo plugin: show a session's heartbeats as a pill, with detail and editing in the side panel",
  "keywords": ["paseo", "paseo-plugin"],
  "homepage": "https://github.com/supermomonga/paseo-heartbeats#readme",
  "bugs": "https://github.com/supermomonga/paseo-heartbeats/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/supermomonga/paseo-heartbeats.git"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "paseo-plugin.json",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "!**/*.test.ts"
  ],
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json",
    "test": "vitest run --passWithNoTests",
    "prepack": "node scripts/pack-manifest.mjs prepack",
    "postpack": "node scripts/pack-manifest.mjs postpack"
  },
  "devDependencies": {
    "@getpaseo/client": "0.15.4",
    "@getpaseo/plugin": "0.15.4",
    "@getpaseo/protocol": "0.15.4",
    "@types/node": "22.18.3",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "5.9.2",
    "vitest": "3.2.7",
    "zod": "4.4.3"
  }
}
